[Desktop Entry]
Categories=AudioVideo;Audio;Player
Comment=Niente FLAC Checker
Exec=/usr/bin/xterm -xrm 'xterm*iconHint: /home/xxxxxxxx/.local/share/niente4/art/nienteico.xpm' -bg black -fg green -geometry 103x28 -fa 'Luxi Mono:style=Regular' -fs 11 -ti 340 -tn xterm-256color -e niente4.sh
GenericName=Niente
Icon=/home/xxxxxxxx/.local/share/niente4/art/nienteico.png
MimeType=
Name=niente4
Path=
StartupNotify=true
StartupWMClass=Xterm
Terminal=false
TerminalOptions=
Type=Application
X-KDE-SubstituteUID=false
X-KDE-Username=
